// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cursor_animation": {
    "enabled": true
  },
  "reveal_if_open": true,
  "session": {
    "trust_all_worktrees": true
  },
  "default_open_behavior": "new_window",
  "context_servers": {
    "Hetzner": {
      "oauth": {
        "client_id": ""
      },
      "enabled": true,
      "url": "https://inference.hetzner.com/api/v1"
    }
  },
  "proxy": "",
  "which_key": {
    "enabled": true,
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "icon_theme": "Deoreal Icons Theme Dark",
  "colorize_brackets": false,
  "agent_ui_font_size": 16.0,
  "ui_font_family": "RobotoMono Nerd Font Mono",
  "languages": {
    "Markdown": {},
    "Plain Text": {},
    "Go": {
      "prettier": {
        "allowed": false,
      },
      "colorize_brackets": false,
      "indent_guides": {
        "coloring": "indent_aware",
        "active_line_width": 2,
      },
      "preferred_line_length": 120,
      "formatter": "language_server",
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "tab_size": 4,
      "hard_tabs": true,
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
      },
    },
    "C": {
      "format_on_save": "on",
    },
    "HTML": {
      "formatter": "prettier",
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "usePlaceholders": true,
        "completeUnimported": true,
        "staticcheck": true,
        "gofumpt": true,
        "analyses": {
          "unusedparams": true,
          "shadow": true,
          "nilness": true,
        },
        "codelenses": {
          "generate": true,
          "gc_details": false,
          "test": true,
          "tidy": true,
          "upgrade_dependency": true,
          "regenerate_cgo": true,
        },
        "semanticTokens": true,
        "hints": {
          "assignVariableTypes": false,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": false,
          "rangeVariableTypes": true,
        },
      },
    },
  },
  "file_types": {
    "HTML": ["gohtml", "tmpl", "tpl"],
  },
  "relative_line_numbers": "enabled",
  "horizontal_scroll_margin": 8.0,
  "vertical_scroll_margin": 6.0,
  "expand_excerpt_lines": 6,
  "autosave": "on_window_change",
  "cursor_shape": "underline",
  "restore_on_startup": "launchpad",
  "file_finder": {
    "file_icons": true,
  },
  "use_smartcase_search": true,
  "vim_mode": true,
  "base_keymap": "TextMate",
  "buffer_font_family": "MesloLGL Nerd Font Mono",
  "ui_font_size": 19.0,
  "buffer_font_size": 16.0,
  "theme": "AmberFawnMidSomer",
}
